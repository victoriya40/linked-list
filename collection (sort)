import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        LinkedList<Integer> list = new LinkedList<>();

        int n = sc.nextInt();

       
        for(int i = 0; i < n; i++) {
            int value = sc.nextInt();
            list.add(value);
        }

        
        Collections.sort(list);

        System.out.println(list);
    }
}
